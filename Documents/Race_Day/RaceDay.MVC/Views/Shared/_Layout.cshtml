<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --bg: #f4f7fb;
            --bg-soft: #eaf2ff;
            --panel: rgba(255, 255, 255, 0.9);
            --surface: #ffffff;
            --primary: #1d4ed8;
            --primary-dark: #123bb3;
            --primary-soft: #dbeafe;
            --secondary: #0f172a;
            --muted: #5b6475;
            --line: rgba(148, 163, 184, 0.25);
            --shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        }

        * { box-sizing: border-box; }

        body {
            font-family: "Segoe UI", Inter, Arial, sans-serif;
            background: linear-gradient(180deg, var(--bg) 0%, #eef5ff 100%);
            color: var(--secondary);
            min-height: 100vh;
        }

        a { text-decoration: none; }

        .navbar {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--line);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: 0.04em;
            color: var(--primary) !important;
            font-size: 1.4rem;
        }

        .nav-link {
            color: #334155 !important;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--primary) !important;
        }

        .navbar-text {
            color: var(--muted) !important;
            font-size: 0.92rem;
        }

        .page-shell {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1.5rem 0 2rem;
        }

        .hero {
            background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #2563eb 100%);
            color: white;
            padding: 4rem 2rem;
            border-radius: 1.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: auto -40px -60px auto;
            width: 220px;
            height: 220px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
        }

        .hero h1 {
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .hero p {
            color: rgba(255, 255, 255, 0.85);
            max-width: 640px;
            margin: 0 auto 1.5rem;
            font-size: 1.08rem;
        }

        .btn {
            border-radius: 0.8rem;
            font-weight: 700;
            padding: 0.7rem 1.3rem;
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            box-shadow: 0 10px 20px rgba(29, 78, 216, 0.25);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
        }

        .btn-light {
            color: var(--primary);
            font-weight: 700;
        }

        .btn-outline-primary {
            border-width: 2px;
        }

        .card-event,
        .card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 1rem;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        }

        .card-event {
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            overflow: hidden;
        }

        .card-event:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 30px rgba(15, 23, 42, 0.08);
            border-color: rgba(29, 78, 216, 0.2);
        }

        .card-img-top {
            border-bottom: 1px solid var(--line);
        }

        .badge {
            border-radius: 999px;
            font-weight: 700;
            letter-spacing: 0.02em;
            padding: 0.5rem 0.75rem;
        }

        .badge.bg-primary {
            background: var(--primary-soft) !important;
            color: var(--primary) !important;
        }

        .form-control,
        .form-select {
            border-radius: 0.8rem;
            border: 1px solid rgba(148, 163, 184, 0.35);
            min-height: 46px;
            padding: 0.75rem 0.9rem;
            background-color: #fff;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(29, 78, 216, 0.5);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15);
        }

        .alert {
            border: none;
            border-radius: 0.9rem;
            padding: 0.9rem 1rem;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        }

        .section-title {
            font-size: clamp(1.7rem, 2vw, 2.4rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 1.5rem;
        }

        footer {
            color: #64748b;
            font-size: 0.95rem;
            padding: 2rem 0 1.25rem;
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">RaceDay</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                @if (Context.Session.GetString("UserRole") == "Participant")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="MyEnrolments">My Enrolments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="MyResults">My Results</a></li>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create Event</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-center">
                @if (Context.Session.GetString("JWToken") != null)
                {
                    <li class="nav-item"><span class="navbar-text me-2">@Context.Session.GetString("UserName") (@Context.Session.GetString("UserRole"))</span></li>
                    <li class="nav-item"><a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Logout">Logout</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<main class="container page-shell">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>
<footer class="text-center">© @DateTime.Now.Year RaceDay — Sports Event Management</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
