@model PaymentFormViewModel
@{
    ViewData["Title"] = "Pay for Ticket";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Complete payment</h3>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <p class="text-muted mb-1">Event</p>
                        <h4 class="mb-0">@Model.EventName</h4>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Ticket</dt>
                        <dd class="col-sm-8">@Model.TicketNumber</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.CategoryName</dd>

                        <dt class="col-sm-4">Ticket Type</dt>
                        <dd class="col-sm-8">@Model.TicketType</dd>

                        <dt class="col-sm-4">Amount Due</dt>
                        <dd class="col-sm-8 fw-bold">R @Model.Amount.ToString("0.00")</dd>
                    </dl>

                    <form asp-action="Pay" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.TicketId" />
                        <input type="hidden" name="amount" value="@Model.Amount" />

                        <div class="border rounded p-3 bg-light mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Total due</span>
                                <span class="fw-bold fs-5">R @Model.Amount.ToString("0.00")</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Events" asp-action="MyEnrolments" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success btn-lg">Pay Now</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
