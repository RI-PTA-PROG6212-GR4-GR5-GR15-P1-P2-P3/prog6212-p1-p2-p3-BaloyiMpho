@model TicketConfirmationViewModel
@{
    ViewData["Title"] = "Enrolment Confirmation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <p class="text-uppercase text-muted mb-1">Registration confirmed</p>
                            <h2 class="mb-0">@Model.EventName</h2>
                        </div>
                        <span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                            @Model.PaymentStatus
                        </span>
                    </div>

                    <div class="alert alert-success">
                        Your enrolment has been created successfully. Please review the ticket details below and complete payment to confirm your place.
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted">Ticket Number</small>
                                <div class="fw-bold fs-5">@Model.TicketNumber</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted">Ticket Type</small>
                                <div class="fw-bold fs-5">@Model.TicketType</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted">Category</small>
                                <div class="fw-bold">@Model.CategoryName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted">Location</small>
                                <div class="fw-bold">@Model.Location</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-4">
                        <div>
                            <small class="text-muted">Amount Due</small>
                            <div class="fw-bold fs-4">R @Model.Price.ToString("0.00")</div>
                        </div>
                        <div class="text-end">
                            <small class="text-muted">Status</small>
                            <div class="fw-bold">@Model.PaymentStatus</div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Events" asp-action="MyEnrolments" class="btn btn-outline-secondary">View My Enrolments</a>
                        @if (Model.PaymentStatus != "Paid")
                        {
                            <a asp-controller="Payment" asp-action="Index" asp-route-ticketId="@Model.TicketId" class="btn btn-success btn-lg">Pay Now</a>
                        }
                        else
                        {
                            <button class="btn btn-success btn-lg" disabled>Payment Complete</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
