@model List<RaceDay.MVC.Models.TicketMineViewModel>

@{
    ViewData["Title"] = "My Tickets";
}

<h1>My Tickets</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (Model == null || !Model.Any())
{
    <p>You have no tickets yet.</p>
    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Browse events</a>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ticket #</th>
                <th>Event</th>
                <th>Category</th>
                <th>Type</th>
                <th>Price</th>
                <th>Paid</th>
                <th>Status</th>
                <th>Purchased</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.TicketNumber</td>
                    <td>@t.EventTitle</td>
                    <td>@t.CategoryName</td>
                    <td>@t.TicketType</td>
                    <td>@t.Price.ToString("C")</td>
                    <td>@t.AmountPaid.ToString("C")</td>
                    <td>@t.PaymentStatus</td>
                    <td>@t.PurchaseDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}