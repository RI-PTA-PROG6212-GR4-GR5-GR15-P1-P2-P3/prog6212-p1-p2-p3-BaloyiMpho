@model EventViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="card shadow">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="card-img-top" style="max-height:300px;object-fit:cover;" />
    }
    <div class="card-body">
        <h2>@Model.Title <span class="badge bg-primary fs-6">@Model.EventType</span></h2>
        <p class="text-muted">@Model.Description</p>
        <ul class="list-unstyled">
            <li><strong> &#128197; Date:</strong> @Model.Date.ToString("dddd, dd MMM yyyy")</li>
            <li><strong> &#128205; Location:</strong> @Model.Location</li>
            <li><strong> &#127939;Distance:</strong> @Model.Distance km</li>
            <li><strong> &#128100; Organiser:</strong> @Model.OrganiserName</li>
        </ul>
        <h4 class="mt-4">Categories</h4>
        @if (Context.Session.GetString("UserRole") == "Participant")
        {
            @foreach (var cat in Model.Categories)
            {
                <form asp-action="Enrol" method="post" class="d-inline-block me-2 mb-2">
                    <input type="hidden" name="eventId" value="@Model.Id" />
                    <input type="hidden" name="categoryId" value="@cat.Id" />
                    <button type="submit" class="btn btn-success">Enrol in @cat.Name</button>
                </form>
            }
        }
        else
        {
            <ul>@foreach (var c in Model.Categories) { <li>@c.Name</li> }</ul>
        }
    </div>
</div>
